# Local development settings. `npm run local:up` creates .env.local from the
# running Supabase stack automatically; copy this file only to set it by hand.

# Booking data: `memory` uses the built-in demo data (resets on restart).
# Leave unset to use Supabase; it also falls back to memory when SUPABASE_URL is unset.
BOOKING_STORE=
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=<service_role key from `npx supabase status`>
PUBLIC_SUPABASE_ANON_KEY=<anon key from `npx supabase status`>

# Email: `mailpit` (local, view at http://localhost:54324), `resend` (production),
# or leave unset to print emails to the server console.
EMAIL_TRANSPORT=mailpit
MAILPIT_URL=http://127.0.0.1:54324
RESEND_API_KEY=
EMAIL_FROM=SessionX <bookings@sessionx.local>

# Origin used for links in emails. Defaults to the request origin when unset.
PUBLIC_APP_URL=http://localhost:5173
